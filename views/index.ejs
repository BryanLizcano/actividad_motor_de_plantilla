<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Lista de Autos - <%= nombre %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header>
        <h1><%= nombre %></h1>
    </header>

    <main>
        <p>¡Bienvenido a mi sitio de autos!</p>

        <% categoriasAutos.forEach(function(cat) { %>
            <section>
                <h2><%= cat.nombre %></h2>
                <nav>
                    <ul>
                        <% cat.autos.forEach(function(auto) { %>
                            <li><%= auto %></li>
                        <% }); %>
                    </ul>
                </nav>
            </section>
        <% }); %>
    </main>
</body>
</html>